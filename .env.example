# Hack Club Auth client secret for the Jumbotron OAuth app (required for organizer sign-in).
CLIENT_SECRET=
# OAuth redirect URI sent with the token exchange; must match the one the frontend signs in with.
REDIRECT=https://jumbotron.hackclub.com/callback
# Slack IDs of admins, separated by semicolons.
ADMINS=U08EMT46G3V
# Extra origins allowed to call the API cross-origin, separated by semicolons (same-origin needs none).
EXTRA_ORIGINS=
# JSON array of RTCIceServer objects for demo time; defaults to Google's public STUN server.
ICE_SERVERS=
# Path to an events JSON file (an /api/allEvents export) to load on startup.
SEED_FILE=
# Proxies to trust for client IPs: an address/subnet list, a hop count, or true; defaults to loopback.
TRUST_PROXY=
# Port the server listens on.
PORT=3000
